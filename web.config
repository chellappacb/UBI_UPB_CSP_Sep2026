		<httpErrors>
			<remove statusCode="500" subStatusCode="-1"/>
			<remove statusCode="404" subStatusCode="-1"/>
			<error statusCode="404" prefixLanguageFilePath="%SystemDrive%\inetpub\custerr" path="404.htm" responseMode="File"/>
